@model IEnumerable<Category>

@{
    ViewBag.PageTitle = "Category Management";
    ViewBag.CardTitle = "View Categories";
}

<style>
    /* Table Header Styling */
    #myTable thead th {
        font-weight: 500;
        color: #6c757d;
        font-size: 0.875rem;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        padding: 1rem 0.75rem;
        border-bottom: 2px solid #e9ecef;
    }

    /* Table Body Styling */
    #myTable tbody td {
        padding: 1rem 0.75rem;
        vertical-align: middle;
    }

    /* Action Button */
    .btn-action {
        padding: 0.4rem 0.9rem;
        font-size: 0.875rem;
        font-weight: 500;
        margin-right: 0.5rem;
    }

    .btn-edit {
        background-color: #667eea;
        border-color: #667eea;
        color: #ffffff;
    }

    .btn-edit:hover {
        background-color: #5568d3;
        border-color: #5568d3;
        color: #ffffff;
    }

    .btn-delete {
        background-color: #dc3545;
        border-color: #dc3545;
        color: #ffffff;
    }

    .btn-delete:hover {
        background-color: #c82333;
        border-color: #bd2130;
        color: #ffffff;
    }

    .btn-create {
        background-color: #667eea;
        border-color: #667eea;
        color: #ffffff;
        padding: 0.5rem 1.25rem;
        font-weight: 500;
        margin-bottom: 1.5rem;
    }

    .btn-create:hover {
        background-color: #5568d3;
        border-color: #5568d3;
        color: #ffffff;
    }

    /* Container */
    .data-container {
        min-height: 500px;
    }

    /* Ensure content wrapper maintains height */
    .card-body {
        min-height: calc(100vh - 250px);
    }
</style>

<div class="data-container">
    <div>
        <a href="/Admin/Category/Create" class="btn btn-create">
            <i class="fas fa-plus"></i> Create New Category
        </a>
    </div>

    <table id="myTable" class="table table-hover" width="100%">
        <thead>
            <tr>
                <th>Name</th>
                <th>Description</th>
                <th>Date Created</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.Name</td>
                    <td>@Html.Raw(item.Description)</td>
                    <td>@item.CreatedTime.ToString("MMM dd, yyyy")</td>
                    <td>
                        <a href="/Admin/Category/Edit/@item.Id" class="btn btn-sm btn-action btn-edit">Edit</a>
                        <a href="/Admin/Category/Delete/@item.Id" class="btn btn-sm btn-action btn-delete">Delete</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
