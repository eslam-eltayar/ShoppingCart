@model OrderViewModel
@using MyShop.Utilities

@{
    var orderStatus = Model.OrderHeader.OrderStatus ?? SD.New;
    var showShippingFields = orderStatus == SD.Processing || orderStatus == SD.Completed;
    var isReadOnly = orderStatus == SD.Completed || orderStatus == SD.Cancelled;
}

<style>
    /* Order Details Page Styling */
    .order-details-container {
        padding: 1.5rem 0;
    }

    .section-header {
        font-size: 1.25rem;
        font-weight: 600;
        color: #2c3e50;
        margin-bottom: 1.5rem;
        padding-bottom: 0.75rem;
        border-bottom: 2px solid #e9ecef;
    }

    .form-group-row {
        margin-bottom: 1.25rem;
    }

    .form-label {
        font-weight: 500;
        color: #495057;
        font-size: 0.9rem;
        margin-bottom: 0.5rem;
    }

    .form-control-readonly {
        background-color: #f8f9fa;
        border-color: #dee2e6;
        color: #6c757d;
        cursor: not-allowed;
    }

    /* Status Badge */
    .order-status-header {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        margin-bottom: 1.5rem;
        padding: 1rem;
        background-color: #f8f9fa;
        border-radius: 0.5rem;
    }

    .order-status-label {
        font-weight: 500;
        color: #6c757d;
        font-size: 0.9rem;
    }

    .order-status-badge {
        display: inline-block;
        padding: 0.4rem 0.9rem;
        border-radius: 0.375rem;
        font-size: 0.9rem;
        font-weight: 600;
    }

    .order-status-badge.new {
        background-color: #fff3cd;
        color: #856404;
    }

    .order-status-badge.processing {
        background-color: #fff4e6;
        color: #b45309;
    }

    .order-status-badge.completed {
        background-color: #d1e7dd;
        color: #0f5132;
    }

    .order-status-badge.cancelled {
        background-color: #f8d7da;
        color: #842029;
    }

    /* Product List */
    .product-item {
        padding: 1rem;
        border-bottom: 1px solid #e9ecef;
    }

    .product-item:last-child {
        border-bottom: none;
    }

    .product-name {
        font-weight: 600;
        color: #2c3e50;
        font-size: 0.95rem;
        margin-bottom: 0.25rem;
    }

    .product-details {
        font-size: 0.85rem;
        color: #6c757d;
        margin-bottom: 0.25rem;
    }

    .product-total {
        font-weight: 600;
        color: #2c3e50;
        font-size: 0.95rem;
    }

    .order-total {
        background-color: #2c3e50;
        color: #ffffff;
        padding: 1.25rem;
        border-radius: 0.5rem;
        margin-top: 1rem;
    }

    .order-total-label {
        font-size: 1rem;
        font-weight: 600;
    }

    .order-total-value {
        font-size: 1.25rem;
        font-weight: 700;
    }

    /* Action Buttons */
    .action-buttons {
        margin-top: 1.5rem;
        display: flex;
        flex-direction: column;
        gap: 0.75rem;
    }

    .btn-primary-action {
        background-color: #667eea;
        border-color: #667eea;
        color: #ffffff;
        padding: 0.75rem 1.5rem;
        font-weight: 500;
    }

    .btn-primary-action:hover {
        background-color: #5568d3;
        border-color: #5568d3;
        color: #ffffff;
    }

    .btn-secondary-action {
        background-color: #6c757d;
        border-color: #6c757d;
        color: #ffffff;
        padding: 0.5rem 1.25rem;
        font-weight: 500;
    }

    .btn-secondary-action:hover {
        background-color: #5a6268;
        border-color: #545b62;
        color: #ffffff;
    }

    .btn-danger-action {
        background-color: #dc3545;
        border-color: #dc3545;
        color: #ffffff;
        padding: 0.75rem 1.5rem;
        font-weight: 500;
    }

    .btn-danger-action:hover {
        background-color: #c82333;
        border-color: #bd2130;
        color: #ffffff;
    }

    /* Spacing improvements */
    .order-details-section {
        padding-right: 2rem;
    }

    .order-summary-section {
        padding-left: 2rem;
    }

    @@media (max-width: 991px) {
        .order-details-section,
        .order-summary-section {
            padding: 0;
            margin-bottom: 2rem;
        }
    }
</style>

<form method="post">
    <div class="order-details-container">
        <input hidden asp-for="OrderHeader.Id" />
        <div class="row">
            <!-- Left Column: Order Details -->
            <div class="col-12 col-lg-6 order-details-section">
                <h4 class="section-header">Order Details</h4>
                
                <div class="form-group-row">
                    <label class="form-label">Full Name</label>
                    @if (isReadOnly)
                    {
                        <input asp-for="OrderHeader.FullName" type="text" class="form-control" readonly />
                    }
                    else
                    {
                        <input asp-for="OrderHeader.FullName" type="text" class="form-control" />
                    }
                    <span asp-validation-for="OrderHeader.FullName" class="text-danger"></span>
                </div>

                <div class="form-group-row">
                    <label class="form-label">Phone Number</label>
                    @if (isReadOnly)
                    {
                        <input asp-for="OrderHeader.PhoneNumber" type="text" class="form-control" readonly />
                    }
                    else
                    {
                        <input asp-for="OrderHeader.PhoneNumber" type="text" class="form-control" />
                    }
                    <span asp-validation-for="OrderHeader.PhoneNumber" class="text-danger"></span>
                </div>

                <div class="form-group-row">
                    <label class="form-label">Address</label>
                    @if (isReadOnly)
                    {
                        <input asp-for="OrderHeader.Address" type="text" class="form-control" readonly />
                    }
                    else
                    {
                        <input asp-for="OrderHeader.Address" type="text" class="form-control" />
                    }
                    <span asp-validation-for="OrderHeader.Address" class="text-danger"></span>
                </div>

                <div class="form-group-row">
                    <label class="form-label">Notes</label>
                    @if (isReadOnly)
                    {
                        <textarea asp-for="OrderHeader.Notes" rows="3" class="form-control" readonly></textarea>
                    }
                    else
                    {
                        <textarea asp-for="OrderHeader.Notes" rows="3" class="form-control"></textarea>
                    }
                    <span asp-validation-for="OrderHeader.Notes" class="text-danger"></span>
                </div>

                <div class="form-group-row">
                    <label class="form-label">Order Date</label>
                    <input value="@Model.OrderHeader.OrderDate.ToString("MMM dd, yyyy")" readonly type="text" class="form-control form-control-readonly" />
                </div>

                @if (showShippingFields)
                {
                    <div class="form-group-row">
                        <label class="form-label">Carrier</label>
                        @if (isReadOnly)
                        {
                            <input asp-for="OrderHeader.Carrier" id="carrier" type="text" class="form-control" readonly />
                        }
                        else
                        {
                            <input asp-for="OrderHeader.Carrier" id="carrier" type="text" class="form-control" />
                        }
                    </div>

                    <div class="form-group-row">
                        <label class="form-label">Tracking Number</label>
                        @if (isReadOnly)
                        {
                            <input asp-for="OrderHeader.TrackingNumber" id="tracking" type="text" class="form-control" readonly />
                        }
                        else
                        {
                            <input asp-for="OrderHeader.TrackingNumber" id="tracking" type="text" class="form-control" />
                        }
                    </div>
                }

                @if (Model.OrderHeader.ShippingDate.HasValue)
                {
                    <div class="form-group-row">
                        <label class="form-label">Shipping Date</label>
                        <input value="@Model.OrderHeader.ShippingDate.Value.ToString("MMM dd, yyyy")" readonly type="text" class="form-control form-control-readonly" />
                    </div>
                }

                @if (!isReadOnly)
                {
                    <div class="form-group-row">
                        <input type="submit" asp-action="UpdateOrderDetails" class="btn btn-secondary-action form-control" value="Save Changes" />
                    </div>
                }
            </div>

            <!-- Right Column: Order Summary -->
            <div class="col-12 col-lg-6 order-summary-section">
                <h4 class="section-header">Order Summary</h4>
                
                <!-- Status Badge -->
                <div class="order-status-header">
                    <span class="order-status-label">Order Status:</span>
                    @{
                        var statusClass = orderStatus.ToLower() switch
                        {
                            "new" => "new",
                            "processing" => "processing",
                            "completed" => "completed",
                            "cancelled" => "cancelled",
                            _ => "new"
                        };
                    }
                    <span class="order-status-badge @statusClass">@orderStatus</span>
                </div>

                <!-- Product List -->
                <div class="list-group mb-3">
                    @foreach (var item in Model.OrderDetails)
                    {
                        <div class="product-item">
                            <div class="d-flex justify-content-between align-items-start">
                                <div class="flex-grow-1">
                                    <div class="product-name">@item.Product.Name</div>
                                    <div class="product-details">
                                        <span>Price: @item.Price.ToString("N2") EGP</span> • 
                                        <span>Quantity: @item.Count</span>
                                    </div>
                                </div>
                                <div class="product-total">
                                    @((item.Count * item.Price).ToString("N2")) EGP
                                </div>
                            </div>
                        </div>
                    }
                </div>

                <!-- Total -->
                <div class="order-total">
                    <div class="d-flex justify-content-between align-items-center">
                        <span class="order-total-label">TOTAL</span>
                        <span class="order-total-value">@(Model.OrderHeader.TotalPrice.ToString("N2")) EGP</span>
                    </div>
                </div>

                <!-- Action Buttons -->
                @if (!isReadOnly)
                {
                    <div class="action-buttons">
                        @if (orderStatus == SD.New)
                        {
                            <input type="submit" asp-action="UpdateStatus" asp-route-status="@SD.Processing" class="btn btn-primary-action form-control" value="Start Order" />
                            <input type="submit" asp-action="UpdateStatus" asp-route-status="@SD.Cancelled" class="btn btn-danger-action form-control" value="Cancel Order" />
                        }
                        else if (orderStatus == SD.Processing)
                        {
                            <input type="submit" asp-action="StartShipping" onclick="return CheckData()" class="btn btn-primary-action form-control" value="Mark as Completed" />
                            <input type="submit" asp-action="UpdateStatus" asp-route-status="@SD.Cancelled" class="btn btn-danger-action form-control" value="Cancel Order" />
                        }
                    </div>
                }
            </div>
        </div>
    </div>
</form>

@section Scripts {
    <script>
        function CheckData() {
            var carrierField = document.getElementById("carrier");
            var trackingField = document.getElementById("tracking");
            
            if (!carrierField || carrierField.value == '') {
                Swal.fire({
                    title: 'Missing Information',
                    text: "Please enter a carrier",
                    icon: 'error',
                    confirmButtonColor: '#3085d6',
                });
                return false;
            }
            if (!trackingField || trackingField.value == '') {
                Swal.fire({
                    title: 'Missing Information',
                    text: "Please enter a tracking number",
                    icon: 'error',
                    confirmButtonColor: '#3085d6',
                });
                return false;
            }
            return true;
        }
    </script>
}
